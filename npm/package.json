{
  "name": "@codegiveness/postgresql-sharp-mcp",
  "version": "0.5.0",
  "description": "Database-agnostic PostgreSQL MCP server with live discovery and bounded per-call selection. Installs one platform package with the .NET runtime bundled; no .NET installation or runtime downloads required.",
  "license": "MIT",
  "author": "codegiveness",
  "homepage": "https://github.com/codegiveness/postgresql-sharp-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegiveness/postgresql-sharp-mcp.git"
  },
  "keywords": ["mcp", "mcp-server", "postgresql", "database"],
  "bin": {
    "postgresql-sharp-mcp": "bin/postgresql-sharp-mcp.exe"
  },
  "engines": {
    "node": ">=22"
  },
  "os": ["linux", "darwin", "win32"],
  "cpu": ["x64", "arm64"],
  "scripts": {
    "postinstall": "postgresql-sharp-mcp-npm-install"
  },
  "optionalDependencies": {
    "@codegiveness/postgresql-sharp-mcp-darwin-arm64": "0.5.0",
    "@codegiveness/postgresql-sharp-mcp-darwin-x64": "0.5.0",
    "@codegiveness/postgresql-sharp-mcp-linux-arm64": "0.5.0",
    "@codegiveness/postgresql-sharp-mcp-linux-x64": "0.5.0",
    "@codegiveness/postgresql-sharp-mcp-win32-x64": "0.5.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/postgresql-sharp-mcp.exe",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "LICENSES/*.txt",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ]
}
