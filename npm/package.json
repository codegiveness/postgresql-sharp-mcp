{
  "name": "@codegiveness/postgresql-sharp-mcp",
  "version": "0.3.1",
  "description": "Database-agnostic PostgreSQL MCP server with live discovery and bounded per-call selection. Requires the .NET 10 runtime; set DOTNET_ROOT for nonstandard installations. No runtime downloads.",
  "license": "MIT",
  "author": "codegiveness",
  "homepage": "https://github.com/codegiveness/postgresql-sharp-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/codegiveness/postgresql-sharp-mcp.git"
  },
  "keywords": ["mcp", "mcp-server", "postgresql", "database"],
  "bin": {
    "postgresql-sharp-mcp": "bin/postgresql-sharp-mcp.exe"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "postinstall": "dotnet installer/PostgreSqlMcp.NpmInstall.dll"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "bin/postgresql-sharp-mcp.exe",
    "payload/",
    "apphosts/",
    "installer/",
    "LICENSE",
    "THIRD-PARTY-NOTICES.md",
    "LICENSES/*.txt",
    "README.md",
    "SECURITY.md",
    "CONTRIBUTING.md"
  ]
}
