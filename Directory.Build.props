<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <_LockFileRidSuffix Condition="'$(RuntimeIdentifier)' != ''">.$(RuntimeIdentifier)</_LockFileRidSuffix>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages$(_LockFileRidSuffix).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
