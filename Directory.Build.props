<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Every analyzer runs; .editorconfig raises all of them to warning, so any diagnostic fails the build (docs/adr/0006). -->
    <AnalysisLevel>latest-all</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <!-- IDE0005 (unnecessary using) only runs in the build when documentation comments are parsed. The XML file stays in obj/ so it never
         reaches build output, publish output or packages (CS1591 is switched off in .editorconfig). -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <CopyDocumentationFileToOutputDirectory>false</CopyDocumentationFileToOutputDirectory>
    <ContinuousIntegrationBuild Condition="'$(Configuration)' == 'Release' or '$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <DisableImplicitLibraryPacksFolder>true</DisableImplicitLibraryPacksFolder>
    <_LockFileRidSuffix Condition="'$(RuntimeIdentifier)' != ''">.$(RuntimeIdentifier)</_LockFileRidSuffix>
    <NuGetLockFilePath>$(MSBuildProjectDirectory)/packages$(_LockFileRidSuffix).lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
