<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <Version>0.7.4</Version>
    <PackAsTool>true</PackAsTool>
    <PackageId>codegiveness.postgresql-sharp-mcp</PackageId>
    <ToolCommandName>postgresql-sharp-mcp</ToolCommandName>
    <Authors>codegiveness</Authors>
    <Copyright>Copyright (c) 2026 codegiveness</Copyright>
    <Description>Database-agnostic PostgreSQL MCP server with live discovery and bounded per-call database selection using Npgsql.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/codegiveness/postgresql-sharp-mcp</PackageProjectUrl>
    <RepositoryUrl>https://github.com/codegiveness/postgresql-sharp-mcp.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>mcp;mcp-server;model-context-protocol;postgresql;postgres;npgsql;dotnet-tool;ai-agent;database</PackageTags>
    <PackageReleaseNotes>https://github.com/codegiveness/postgresql-sharp-mcp/blob/main/CHANGELOG.md</PackageReleaseNotes>
  </PropertyGroup>
  <!-- The .NET tool is RID-specific and self-contained, so it needs no installed .NET runtime. `dotnet pack` writes one pointer package
       plus one package per RID below; there is deliberately no framework-dependent `any` package. These RIDs are the ones npm and the
       release archives already ship. Only packing restores them: a normal restore must not download five runtime packs, and the
       five-RID graph has its own lock file (packages.tool.lock.json) beside the portable and per-RID ones. -->
  <PropertyGroup>
    <ToolPackageRuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</ToolPackageRuntimeIdentifiers>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPacking)' == 'true'">
    <RuntimeIdentifiers>$(ToolPackageRuntimeIdentifiers)</RuntimeIdentifiers>
    <NuGetLockFilePath Condition="'$(RuntimeIdentifier)' == ''">$(MSBuildProjectDirectory)/packages.tool.lock.json</NuGetLockFilePath>
    <PublishSelfContained Condition="'$(RuntimeIdentifier)' != ''">true</PublishSelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../PostgreSqlMcp.Tools/PostgreSqlMcp.Tools.csproj" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../SECURITY.md" Pack="true" PackagePath="/" />
    <None Include="../../CONTRIBUTING.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.md" Link="THIRD-PARTY-NOTICES.md" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="/" />
    <None Include="../../LICENSES/*.txt" Link="LICENSES/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Pack="true" PackagePath="LICENSES/" />
  </ItemGroup>
</Project>
